# ---------------------------------------------------------------------------
# AFC Command Center — environment variables
# Copy to .env.local for local development, or set these in Vercel.
# ---------------------------------------------------------------------------

# Notion internal integration token (starts with "ntn_" or "secret_").
# Create at https://www.notion.so/my-integrations, then share each database
# below with the integration (Notion page -> ... -> Connections -> your app).
NOTION_TOKEN=

# Database IDs. Open each database as a full page; the ID is the 32-char
# hex string in the URL: notion.so/<workspace>/<DATABASE_ID>?v=<view_id>
NOTION_DB_CONTENT=
NOTION_DB_SHORTS=
NOTION_DB_CLIPS=
NOTION_DB_ADS=
NOTION_DB_COMPANIES=

# Shared team password for signing in to the dashboard.
DASHBOARD_PASSWORD=

# Random secret used to sign the session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Property mapping as a JSON string. Use this on Vercel, where the
# filesystem is read-only. Generated for you by the /setup page.
# DASHBOARD_MAPPING_JSON=

# Optional. Set to 1 to run against bundled fixture data with no Notion
# token at all. Useful for local UI work and demos.
# MOCK_NOTION=1
